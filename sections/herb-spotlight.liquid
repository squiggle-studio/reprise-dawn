{{ 'section-herb-spotlight.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #HerbSpotlight-{{ section.id }} {
    --herb-spotlight-card-radius: {{ section.settings.card_corner_radius }}px;
    --herb-spotlight-image-radius: {{ section.settings.image_corner_radius }}px;
    --herb-spotlight-accent-color: {{ section.settings.accent_color }};
    --herb-spotlight-accent-size: {{ section.settings.accent_icon_size }}%;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.section_color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div
      id="HerbSpotlight-{{ section.id }}"
      class="herb-spotlight herb-spotlight--{{ section.settings.layout }} color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    >
      <div class="herb-spotlight__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2 class="herb-spotlight__heading inline-richtext {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- when 'text' -%}
              <div class="herb-spotlight__text rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="herb-spotlight__media">
        <div class="herb-spotlight__image-frame">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag: widths: '300, 450, 600, 900, 1200', sizes: '(min-width: 750px) 38vw, 100vw', class: 'herb-spotlight__image'
            }}
          {%- else -%}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg herb-spotlight__image-placeholder' }}
          {%- endif -%}
        </div>
        {%- if section.settings.accent_icon != blank -%}
          <span
            class="herb-spotlight__accent"
            style="--herb-spotlight-accent-url: url('{{ section.settings.accent_icon | image_url }}');"
            aria-hidden="true"
          ></span>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Herb spotlight",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "accent_icon",
      "label": "Accent icon",
      "info": "Optional decorative icon overlapping the image corner. Recolored using the accent color below."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent icon color",
      "default": "#AF412F"
    },
    {
      "type": "range",
      "id": "accent_icon_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "%",
      "label": "Accent icon size",
      "default": 38
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position (desktop)",
      "options": [
        { "value": "image_left", "label": "Image left" },
        { "value": "image_right", "label": "Image right" }
      ],
      "default": "image_left",
      "info": "Image always stacks below the text on mobile."
    },
    {
      "type": "range",
      "id": "image_corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Card color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "The magic of [herb]",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Herb spotlight",
      "blocks": [
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
